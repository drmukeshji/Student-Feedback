# SQLite for local development. For production (e.g. Vercel) use a hosted
# PostgreSQL URL and set provider = "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Long random string used to sign login sessions (e.g. `openssl rand -base64 32`)
AUTH_SECRET="change-me-to-a-long-random-string"
